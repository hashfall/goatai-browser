{
  "manifest_version": 3,
  "name": "Goatai IA",
  "version": "0.1.0",
  "description": "Assistente de IA do Goatai com controle do navegador.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
