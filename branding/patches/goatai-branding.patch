+GoataiChatUI::GoataiChatUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUIGoataiChatHost);
+  source->AddResourcePath("app.js", IDR_GOATAI_CHAT_APP_JS);
+  source->AddResourcePath("app.css", IDR_GOATAI_CHAT_APP_CSS);
+  source->SetDefaultResource(IDR_GOATAI_CHAT_INDEX_HTML);
+  web_ui->AddMessageHandler(std::make_unique<GoataiChatHandler>());
+}
+
+GoataiChatUI::~GoataiChatUI() = default;
+
+GoataiChatUIConfig::GoataiChatUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme,
+                         chrome::kChromeUIGoataiChatHost) {}
