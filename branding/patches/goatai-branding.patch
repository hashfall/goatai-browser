+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_TOOLBAR_AUTO_HIDE_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_TOOLBAR_AUTO_HIDE_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/timer/timer.h"
+#include "ui/events/event_observer.h"
+#include "ui/views/focus/focus_manager.h"
+
+class BrowserView;
+class ToolbarView;
+
+namespace views {
+class EventMonitor;
+}  // namespace views
+
+// Esconde a toolbar quando o conteúdo está em foco e o mouse não está sobre
+// ela, e mostra de novo ao encostar o mouse no topo da janela, ao focar a
+// omnibox ou ao abrir menus/bolhas da toolbar (o conteúdo deixa de ter foco).
+class ToolbarAutoHideController : public ui::EventObserver,
+                                  public views::FocusChangeListener {
+ public:
+  ToolbarAutoHideController(BrowserView* browser_view, ToolbarView* toolbar);
+  ToolbarAutoHideController(const ToolbarAutoHideController&) = delete;
+  ToolbarAutoHideController& operator=(const ToolbarAutoHideController&) =
+      delete;
+  ~ToolbarAutoHideController() override;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override;
+
+  // views::FocusChangeListener:
+  void OnWillChangeFocus(views::View* focused_before,
+                         views::View* focused_now) override;
+  void OnDidChangeFocus(views::View* focused_before,
+                        views::View* focused_now) override;
+
+ private:
+  bool MouseOverToolbar() const;
+  bool FocusInToolbar() const;
+  bool ContentsHasFocus() const;
+  bool ShouldSuspend() const;
+
+  void ShowToolbar();
+  void ScheduleHide();
+  void HideToolbarIfAllowed();
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<ToolbarView> toolbar_;
+  raw_ptr<views::FocusManager> focus_manager_ = nullptr;
+  std::unique_ptr<views::EventMonitor> event_monitor_;
+  base::OneShotTimer hide_timer_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_TOOLBAR_AUTO_HIDE_H_
