+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "goatai.setModel",
+      base::BindRepeating(&GoataiChatHandler::HandleSetModel,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "goatai.setControl",
+      base::BindRepeating(&GoataiChatHandler::HandleSetControl,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "goatai.saveKey",
+      base::BindRepeating(&GoataiChatHandler::HandleSaveKey,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "goatai.clearKey",
+      base::BindRepeating(&GoataiChatHandler::HandleClearKey,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "goatai.send", base::BindRepeating(&GoataiChatHandler::HandleSend,
+                                         base::Unretained(this)));
+
+  PrefService* service = prefs();
+  if (service) {
+    const std::string stored = service->GetString(goatai::kChatProviderPref);
+    if (IsValidProvider(stored)) {
+      provider_ = stored;
+    }
+    control_enabled_ = service->GetBoolean(goatai::kChatControlPref);
+  }
+}
