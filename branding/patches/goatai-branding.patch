+std::string DictToJson(const base::DictValue& dict) {
+  std::string json;
+  base::JSONWriter::Write(dict, &json);
+  return json;
+}
+
+std::string StringToJson(const std::string& value) {
+  std::string json;
+  base::JSONWriter::Write(base::Value(value), &json);
+  return json;
+}
+
+std::string StringArg(const base::DictValue* args, const char* key) {
+  if (!args) {
+    return std::string();
+  }
+  const std::string* value = args->FindString(key);
+  return value ? *value : std::string();
+}
+
+int IntArg(const base::DictValue* args, const char* key, int fallback) {
+  if (!args) {
+    return fallback;
+  }
+  return args->FindInt(key).value_or(fallback);
+}
+
+bool BoolArg(const base::DictValue* args, const char* key) {
+  if (!args) {
+    return false;
+  }
+  return args->FindBool(key).value_or(false);
+}
+
+std::string ExtractError(const std::string& body) {
+  auto dict = base::JSONReader::ReadDict(body, base::JSON_PARSE_RFC);
+  if (dict) {
+    const base::Value* error = dict->Find("error");
+    if (error) {
+      if (error->is_dict()) {
+        const std::string* message = error->GetDict().FindString("message");
+        if (message && !message->empty()) {
+          return *message;
+        }
+      } else if (error->is_string()) {
+        return error->GetString();
+      }
+    }
+    const std::string* message = dict->FindString("message");
+    if (message && !message->empty()) {
+      return *message;
+    }
+  }
+  if (body.empty()) {
+    return "resposta vazia do provedor";
+  }
+  return body.substr(0, 300);
+}
+
+std::string ExtractText(const std::string& provider,
+                        const base::DictValue& dict) {
+  if (provider == "claude") {
+    const base::ListValue* content = dict.FindList("content");
+    if (!content) {
+      return std::string();
+    }
+    std::string text;
+    for (const base::Value& item : *content) {
+      if (!item.is_dict()) {
+        continue;
+      }
+      const base::DictValue& block = item.GetDict();
+      const std::string* type = block.FindString("type");
+      if (type && *type == "text") {
+        const std::string* piece = block.FindString("text");
+        if (piece) {
+          text += *piece;
+        }
+      }
+    }
+    return text;
+  }
+
+  if (provider == "gemini") {
+    const base::ListValue* candidates = dict.FindList("candidates");
+    if (!candidates || candidates->empty()) {
+      return std::string();
+    }
+    const base::DictValue* candidate = (*candidates)[0].GetIfDict();
+    if (!candidate) {
+      return std::string();
+    }
+    const base::DictValue* content = candidate->FindDict("content");
+    if (!content) {
+      return std::string();
+    }
+    const base::ListValue* parts = content->FindList("parts");
+    if (!parts) {
+      return std::string();
+    }
+    std::string text;
+    for (const base::Value& part : *parts) {
+      if (!part.is_dict()) {
+        continue;
+      }
+      const std::string* piece = part.GetDict().FindString("text");
+      if (piece) {
+        text += *piece;
+      }
+    }
+    return text;
+  }
+
+  // OpenAI / DeepSeek.
+  const base::ListValue* choices = dict.FindList("choices");
+  if (!choices || choices->empty()) {
+    return std::string();
+  }
+  const base::DictValue* choice = (*choices)[0].GetIfDict();
+  if (!choice) {
+    return std::string();
+  }
+  const base::DictValue* message = choice->FindDict("message");
+  if (!message) {
+    return std::string();
+  }
+  const std::string* content = message->FindString("content");
+  return content ? *content : std::string();
+}
