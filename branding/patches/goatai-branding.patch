+
+class BrowserWindowInterface;
+class PrefService;
+class Profile;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+// Backend do painel Goatai IA.
+//
+// Segurança:
+//  - a chave de API é cifrada com OSCrypt (cofre do sistema) e guardada em
+//    base64 nas preferências do perfil;
+//  - a chave nunca é enviada para a página (a UI recebe apenas os 4 últimos
+//    caracteres);
+//  - as requisições HTTP saem do processo do navegador, não do renderer.
+class GoataiChatHandler : public content::WebUIMessageHandler {
+ public:
+  GoataiChatHandler();
+  GoataiChatHandler(const GoataiChatHandler&) = delete;
+  GoataiChatHandler& operator=(const GoataiChatHandler&) = delete;
+  ~GoataiChatHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  struct ChatMessage {
+    std::string role;     // "user" ou "assistant"
+    std::string content;
+  };
+
+  // Mensagens vindas da página.
+  void HandleGetState(const base::ListValue& args);
+  void HandleSetProvider(const base::ListValue& args);
+  void HandleSetModel(const base::ListValue& args);
+  void HandleSetControl(const base::ListValue& args);
+  void HandleSaveKey(const base::ListValue& args);
+  void HandleClearKey(const base::ListValue& args);
+  void HandleSend(const base::ListValue& args);
+
+  // Infra.
+  Profile* profile() const;
+  content::WebUI* ui() const;
+  PrefService* prefs() const;
+  void EnsureEncryptor(base::OnceCallback<void(bool)> callback);
+  void Notify(base::DictValue event);
+  void NotifyError(const std::string& message);
+  void NotifyStatus(const std::string& text);
+  void NotifyAction(const std::string& text);
+  void SendState();
+
+  std::string Provider() const;
+  std::string Model() const;
+  std::string DefaultModelFor(const std::string& provider) const;
+  std::string KeyPrefFor(const std::string& provider) const;
+  std::string ModelPrefFor(const std::string& provider) const;
+  std::string StoredKeyPref(const std::string& provider) const;
+  std::string DecryptStoredKey(const std::string& provider) const;
+  std::string MaskKey(const std::string& key) const;
+  bool IsValidProvider(const std::string& provider) const;
+
+  // Conversa / provedor.
+  std::string BuildSystemPrompt() const;
+  std::string BuildRequestBody() const;
+  void AddContextToSystem(std::string* system) const;
+  void SendStep(int step);
+  void OnProviderResponse(int step, std::optional<std::string> body);
+  void HandleModelText(int step, const std::string& text);
+  std::optional<base::DictValue> ParseAction(const std::string& text) const;
+
+  // Ferramentas de navegador.
+  BrowserWindowInterface* GetBrowserWindow() const;
+  content::WebContents* GetActiveWebContents() const;
+  void ExecuteAction(const std::string& action,
+                     const base::DictValue* args,
+                     base::OnceCallback<void(std::string)> callback);
+  void RunJavaScript(const std::u16string& script,
+                     base::OnceCallback<void(std::string)> callback);
+
+  std::string provider_ = "gpt";
+  bool control_enabled_ = true;
+  std::vector<ChatMessage> messages_;
+  scoped_refptr<os_crypt_async::Encryptor> encryptor_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  bool waiting_ = false;
+
+  base::WeakPtrFactory<GoataiChatHandler> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_GOATAI_CHAT_GOATAI_CHAT_HANDLER_H_
