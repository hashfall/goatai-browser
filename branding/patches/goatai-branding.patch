+void GoataiChatHandler::AddContextToSystem(std::string* system) const {
+  BrowserWindowInterface* browser = GetBrowserWindow();
+  if (!browser || !browser->GetTabStripModel()) {
+    return;
+  }
+  content::WebContents* contents =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  if (!contents) {
+    return;
+  }
+  system->append("\nContexto atual: aba ativa \"");
+  system->append(base::UTF16ToUTF8(contents->GetTitle()));
+  system->append("\" em ");
+  system->append(contents->GetLastCommittedURL().possibly_invalid_spec());
+  system->append(".");
+}
+
+std::string GoataiChatHandler::BuildRequestBody() const {
+  const std::string model = Model();
+  std::string system = BuildSystemPrompt();
+  AddContextToSystem(&system);
+
+  base::DictValue body;
+  if (provider_ == "claude") {
+    body.Set("model", model);
+    body.Set("max_tokens", 2048);
+    body.Set("system", system);
+    base::ListValue list;
+    for (const ChatMessage& message : messages_) {
+      list.Append(RoleContent(message.role, message.content));
+    }
+    body.Set("messages", std::move(list));
+    return DictToJson(body);
+  }
+
+  if (provider_ == "gemini") {
+    base::DictValue system_instruction;
+    base::ListValue system_parts;
+    system_parts.Append(GeminiPart(system));
+    system_instruction.Set("parts", std::move(system_parts));
+    body.Set("systemInstruction", std::move(system_instruction));
+
+    base::ListValue contents;
+    for (const ChatMessage& message : messages_) {
+      base::DictValue content;
+      content.Set("role", message.role == kRoleAssistant ? "model" : "user");
+      base::ListValue parts;
+      parts.Append(GeminiPart(message.content));
+      content.Set("parts", std::move(parts));
+      contents.Append(std::move(content));
+    }
+    body.Set("contents", std::move(contents));
+
+    base::DictValue generation;
+    generation.Set("maxOutputTokens", 2048);
+    body.Set("generationConfig", std::move(generation));
+    return DictToJson(body);
+  }
+
+  // OpenAI e DeepSeek (API compatível).
+  base::ListValue list;
+  list.Append(RoleContent("system", system));
+  for (const ChatMessage& message : messages_) {
+    list.Append(RoleContent(message.role, message.content));
+  }
+  body.Set("model", model);
+  body.Set("messages", std::move(list));
+  body.Set("temperature", 0.7);
+  return DictToJson(body);
+}
+
+void GoataiChatHandler::SendStep(int step) {
+  if (!encryptor_) {
+    NotifyError("Cofre do sistema indisponível.");
+    return;
+  }
+  const std::string key = DecryptStoredKey(provider_);
+  if (key.empty()) {
+    NotifyError("Chave de API ausente ou ilegível. Salve a chave novamente.");
+    return;
+  }
+  if (step >= kMaxSteps) {
+    messages_.push_back(
+        {kRoleAssistant, "Limite de ações atingido nesta rodada."});
+    base::DictValue event;
+    event.Set("type", "reply");
+    event.Set("text", "Limite de ações atingido nesta rodada.");
+    Notify(std::move(event));
+    waiting_ = false;
+    return;
+  }
+
+  NotifyStatus(base::StrCat({"Consultando ", provider_, "…"}));
+
+  const std::string model = Model();
+  GURL endpoint;
+  if (provider_ == "gpt") {
+    endpoint = GURL("https://api.openai.com/v1/chat/completions");
+  } else if (provider_ == "deepseek") {
+    endpoint = GURL("https://api.deepseek.com/chat/completions");
+  } else if (provider_ == "claude") {
+    endpoint = GURL("https://api.anthropic.com/v1/messages");
+  } else if (provider_ == "gemini") {
+    endpoint = GURL("https://generativelanguage.googleapis.com/v1beta/models/" +
+                    model + ":generateContent");
+  }
+  if (!endpoint.is_valid()) {
+    NotifyError("URL do provedor inválida.");
+    return;
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->method = "POST";
+  request->url = endpoint;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader("Content-Type", "application/json");
+  request->headers.SetHeader("Accept", "application/json");
+  if (provider_ == "claude") {
+    request->headers.SetHeader("x-api-key", key);
+    request->headers.SetHeader("anthropic-version", "2023-06-01");
+  } else if (provider_ == "gemini") {
+    request->headers.SetHeader("x-goog-api-key", key);
+  } else {
+    request->headers.SetHeader("Authorization", base::StrCat({"Bearer ", key}));
+  }
+
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kTrafficAnnotation);
+  loader_->SetAllowHttpErrorResults(true);
+  loader_->SetTimeoutDuration(base::Seconds(120));
+  loader_->DownloadToString(
+      profile()->GetURLLoaderFactory().get(),
+      base::BindOnce(&GoataiChatHandler::OnProviderResponse,
+                     weak_factory_.GetWeakPtr(), step),
+      kMaxResponseBytes);
+}
+
+void GoataiChatHandler::OnProviderResponse(int step,
+                                           std::optional<std::string> body) {
+  const int net_error = loader_ ? loader_->NetError() : net::ERR_FAILED;
+  int response_code = 0;
+  if (loader_ && loader_->ResponseInfo() &&
+      loader_->ResponseInfo()->headers) {
+    response_code = loader_->ResponseInfo()->headers->response_code();
+  }
+  loader_.reset();
+
+  if (net_error != net::OK || !body.has_value()) {
+    NotifyError(base::StrCat(
+        {"Falha de rede ao falar com o provedor (",
+         net::ErrorToString(net_error), ")."}));
+    return;
+  }
+
+  if (response_code >= 400) {
+    NotifyError(base::StrCat({"Erro do provedor (HTTP ",
+                              base::NumberToString(response_code), "): ",
+                              ExtractError(*body)}));
+    return;
+  }
+
+  auto dict = base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC);
+  if (!dict) {
+    NotifyError("Resposta do provedor não é JSON válido.");
+    return;
+  }
+
+  std::string text;
+  if (provider_ == "claude") {
+    text = ExtractText(provider_, *dict);
+  } else if (provider_ == "gemini") {
+    text = ExtractText(provider_, *dict);
+  } else {
+    text = ExtractText(provider_, *dict);
+  }
+  if (text.empty()) {
+    NotifyError("O provedor não retornou texto. Verifique o modelo escolhido.");
+    return;
+  }
+
+  HandleModelText(step, text);
+}
+
+void GoataiChatHandler::HandleModelText(int step, const std::string& text) {
+  std::optional<base::DictValue> action = ParseAction(text);
+  if (action && control_enabled_) {
+    const std::string action_name =
+        action->FindString("action") ? *action->FindString("action") : "";
+    const base::DictValue* args = action->FindDict("args");
+    messages_.push_back({kRoleAssistant, text});
+    NotifyAction(base::StrCat({"▶ ", action_name}));
+    ExecuteAction(
+        action_name, args,
+        base::BindOnce(
+            [](base::WeakPtr<GoataiChatHandler> self, int step,
+               std::string result) {
+              if (!self) {
+                return;
+              }
+              self->messages_.push_back(
+                  {kRoleUser, base::StrCat({"Resultado da ação: ", result})});
+              self->SendStep(step + 1);
+            },
+            weak_factory_.GetWeakPtr(), step));
+    return;
+  }
+
+  messages_.push_back({kRoleAssistant, text});
+  base::DictValue event;
+  event.Set("type", "reply");
+  event.Set("text", text);
+  Notify(std::move(event));
+  waiting_ = false;
+}
+
+std::optional<base::DictValue> GoataiChatHandler::ParseAction(
+    const std::string& text) const {
+  std::string candidate = text;
+  const size_t fence = candidate.find("```");
+  if (fence != std::string::npos) {
+    const size_t fence_end = candidate.find("```", fence + 3);
+    if (fence_end != std::string::npos) {
+      candidate = candidate.substr(fence + 3, fence_end - fence - 3);
+    }
+  }
+  const size_t start = candidate.find('{');
+  const size_t end = candidate.rfind('}');
+  if (start == std::string::npos || end == std::string::npos || end <= start) {
+    return std::nullopt;
+  }
+  auto dict = base::JSONReader::ReadDict(
+      candidate.substr(start, end - start + 1), base::JSON_PARSE_RFC);
+  if (!dict) {
+    return std::nullopt;
+  }
+  const std::string* action = dict->FindString("action");
+  if (!action) {
+    return std::nullopt;
+  }
+  static const char* const kAllowed[] = {
+      "open_tab", "list_tabs", "switch_tab", "close_tab", "navigate",
+      "back",     "forward",   "reload",     "read_page",  "click",
+      "type",     "scroll",
+  };
+  for (const char* allowed : kAllowed) {
+    if (*action == allowed) {
+      return dict;
+    }
+  }
+  return std::nullopt;
+}
