+void GoataiChatHandler::Notify(base::DictValue event) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  CallJavascriptFunction("goataiChatEvent", base::Value(DictToJson(event)));
+}
+
+void GoataiChatHandler::NotifyError(const std::string& message) {
+  base::DictValue event;
+  event.Set("type", "error");
+  event.Set("message", message);
+  Notify(std::move(event));
+  waiting_ = false;
+}
+
+void GoataiChatHandler::NotifyStatus(const std::string& text) {
+  base::DictValue event;
+  event.Set("type", "status");
+  event.Set("text", text);
+  Notify(std::move(event));
+}
+
+void GoataiChatHandler::NotifyAction(const std::string& text) {
+  base::DictValue event;
+  event.Set("type", "action");
+  event.Set("text", text);
+  Notify(std::move(event));
+}
+
+void GoataiChatHandler::SendState() {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  const std::string key = DecryptStoredKey(provider_);
+  base::DictValue event;
+  event.Set("type", "state");
+  event.Set("provider", provider_);
+  event.Set("model", Model());
+  event.Set("control", control_enabled_);
+  event.Set("hasKey", !StoredKeyPref(provider_).empty());
+  event.Set("masked", key.empty() ? std::string() : MaskKey(key));
+  Notify(std::move(event));
+}
