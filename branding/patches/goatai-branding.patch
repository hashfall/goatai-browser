+void GoataiChatHandler::HandleGetState(const base::ListValue& args) {
+  if (!encryptor_) {
+    EnsureEncryptor(base::BindOnce(
+        [](base::WeakPtr<GoataiChatHandler> self, bool /*ok*/) {
+          if (self) {
+            self->SendState();
+          }
+        },
+        weak_factory_.GetWeakPtr()));
+  }
+  SendState();
+}
+
+void GoataiChatHandler::HandleSetProvider(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string()) {
+    return;
+  }
+  const std::string provider = args[0].GetString();
+  if (!IsValidProvider(provider)) {
+    return;
+  }
+  provider_ = provider;
+  messages_.clear();
+  if (PrefService* service = prefs()) {
+    service->SetString(goatai::kChatProviderPref, provider_);
+  }
+  SendState();
+}
+
+void GoataiChatHandler::HandleSetModel(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string()) {
+    return;
+  }
+  const std::string model = args[0].GetString();
+  if (PrefService* service = prefs()) {
+    service->SetString(ModelPrefFor(provider_), model);
+  }
+  SendState();
+}
+
+void GoataiChatHandler::HandleSetControl(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_bool()) {
+    return;
+  }
+  control_enabled_ = args[0].GetBool();
+  if (PrefService* service = prefs()) {
+    service->SetBoolean(goatai::kChatControlPref, control_enabled_);
+  }
+  SendState();
+}
+
+void GoataiChatHandler::HandleSaveKey(const base::ListValue& args) {
+  if (args.size() < 2 || !args[0].is_string() || !args[1].is_string()) {
+    return;
+  }
+  const std::string provider = args[0].GetString();
+  const std::string key = args[1].GetString();
+  if (!IsValidProvider(provider) || key.empty()) {
+    return;
+  }
+  EnsureEncryptor(base::BindOnce(
+      [](base::WeakPtr<GoataiChatHandler> self, std::string provider,
+         std::string key, bool ok) {
+        if (!self) {
+          return;
+        }
+        if (!ok || !self->encryptor_) {
+          self->NotifyError(
+              "Não foi possível acessar o cofre do sistema para cifrar a "
+              "chave.");
+          return;
+        }
+        std::string cipher;
+        if (!self->encryptor_->EncryptString(key, &cipher)) {
+          self->NotifyError("Falha ao cifrar a chave de API.");
+          return;
+        }
+        if (PrefService* service = self->prefs()) {
+          service->SetString(self->KeyPrefFor(provider),
+                             base::Base64Encode(cipher));
+        }
+        if (provider == self->provider_) {
+          self->messages_.clear();
+        }
+        self->SendState();
+      },
+      weak_factory_.GetWeakPtr(), provider, key));
+}
+
+void GoataiChatHandler::HandleClearKey(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string()) {
+    return;
+  }
+  const std::string provider = args[0].GetString();
+  if (!IsValidProvider(provider)) {
+    return;
+  }
+  if (PrefService* service = prefs()) {
+    service->ClearPref(KeyPrefFor(provider));
+  }
+  messages_.clear();
+  SendState();
+}
+
+void GoataiChatHandler::HandleSend(const base::ListValue& args) {
+  if (args.empty() || !args[0].is_string() || waiting_) {
+    return;
+  }
+  const std::string prompt = args[0].GetString();
+  if (prompt.empty()) {
+    return;
+  }
+  if (StoredKeyPref(provider_).empty()) {
+    NotifyError("Configure a chave de API do provedor antes de conversar.");
+    return;
+  }
+  messages_.push_back({kRoleUser, prompt});
+  waiting_ = true;
+  EnsureEncryptor(base::BindOnce(
+      [](base::WeakPtr<GoataiChatHandler> self, int step, bool ok) {
+        if (!self) {
+          return;
+        }
+        if (!ok) {
+          self->NotifyError("Cofre do sistema indisponível.");
+          return;
+        }
+        self->SendStep(step);
+      },
+      weak_factory_.GetWeakPtr(), 0));
+}
+
+std::string GoataiChatHandler::BuildSystemPrompt() const {
+  std::string prompt =
+      "Você é o Goatai IA, um assistente dentro do navegador Goatai. "
+      "Responda em português do Brasil, de forma direta e útil. ";
+  prompt +=
+      "Nunca invente o resultado de uma ação; se precisar de dados da página, "
+      "use uma ação de leitura. ";
+  if (!control_enabled_) {
+    prompt +=
+        "O controle do navegador está DESATIVADO. Apenas converse; não emita "
+        "ações.";
+    return prompt;
+  }
+  prompt +=
+      "Você pode controlar o navegador. Quando precisar executar uma ação, "
+      "responda SOMENTE com um JSON válido, sem markdown e sem texto em volta, "
+      "no formato {\"action\":\"nome\",\"args\":{...}}. "
+      "Use no máximo uma ação por resposta. Depois de cada ação você receberá "
+      "uma mensagem 'Resultado da ação: ...'. Quando terminar, responda em "
+      "texto normal (sem JSON). Ações disponíveis:\n"
+      "- open_tab {\"url\":\"https://...\"}\n"
+      "- list_tabs {}\n"
+      "- switch_tab {\"index\":0}\n"
+      "- close_tab {\"index\":0}\n"
+      "- navigate {\"url\":\"https://...\"} (aba ativa)\n"
+      "- back {}\n- forward {}\n- reload {}\n"
+      "- read_page {} (texto visível da aba ativa)\n"
+      "- click {\"selector\":\"...\"} ou {\"text\":\"...\"}\n"
+      "- type {\"selector\":\"...\",\"text\":\"...\",\"submit\":false}\n"
+      "- scroll {\"direction\":\"down\"} ou {\"direction\":\"up\"}\n";
+  return prompt;
+}
