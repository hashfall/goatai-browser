diff --git a/chrome/browser/resources/goatai_chat/app.css b/chrome/browser/resources/goatai_chat/app.css
new file mode 100644
index 0000000000..25ed25bdb8
--- /dev/null
+++ b/chrome/browser/resources/goatai_chat/app.css
@@ -0,0 +1,275 @@
+/* Goatai IA — tema retrô vaporwave (quadrado, neon). */
+
+:root {
+  --bg: #0a0420;
+  --panel: #10062a;
+  --field: #12062b;
+  --field-hover: #1b0b3b;
+  --cyan: #05d9e8;
+  --magenta: #ff2a6d;
+  --text: #e8f9ff;
+  --muted: #7dd3fc;
+  --border: #05d9e8;
+}
+
+* {
+  border-radius: 0 !important;
+  box-sizing: border-box;
+}
+
+html,
+body {
+  height: 100%;
+  margin: 0;
+}
+
+body {
+  background:
+    linear-gradient(rgba(5, 217, 232, .07) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(5, 217, 232, .07) 1px, transparent 1px),
+    linear-gradient(180deg, rgba(255, 42, 109, .16), transparent 55%),
+    var(--bg);
+  background-size: 28px 28px, 28px 28px, 100% 100%, 100% 100%;
+  color: var(--text);
+  font-family: 'DejaVu Sans Mono', 'Courier New', monospace;
+  font-size: 13px;
+}
+
+#app {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+}
+
+header {
+  align-items: center;
+  background: var(--panel);
+  border-bottom: 1px solid var(--cyan);
+  box-shadow: 0 1px 10px rgba(5, 217, 232, .35);
+  display: flex;
+  justify-content: space-between;
+  padding: 10px 12px;
+}
+
+.brand {
+  color: var(--cyan);
+  font-weight: 700;
+  letter-spacing: 2px;
+  text-shadow: 0 0 8px rgba(5, 217, 232, .7);
+}
+
+.brand span {
+  color: var(--magenta);
+  margin-left: 4px;
+  text-shadow: 0 0 8px rgba(255, 42, 109, .7);
+}
+
+button {
+  background: var(--field);
+  border: 1px solid var(--cyan);
+  color: var(--cyan);
+  cursor: pointer;
+  font-family: inherit;
+  font-size: 12px;
+  padding: 7px 10px;
+  transition: background-color .12s linear, box-shadow .12s linear;
+}
+
+button:hover {
+  background: var(--field-hover);
+  box-shadow: 0 0 10px rgba(5, 217, 232, .45);
+}
+
+button.primary {
+  background: var(--magenta);
+  border-color: var(--magenta);
+  color: #fff;
+  font-weight: 700;
+}
+
+button.primary:hover {
+  box-shadow: 0 0 12px rgba(255, 42, 109, .6);
+}
+
+button.icon {
+  border: none;
+  background: transparent;
+  font-size: 16px;
+  padding: 2px 6px;
+}
+
+#settings {
+  background: var(--panel);
+  border-bottom: 1px solid var(--cyan);
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+  padding: 12px;
+}
+
+#settings[hidden] {
+  display: none;
+}
+
+.field {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.field > span {
+  color: var(--muted);
+  font-size: 11px;
+  letter-spacing: 1px;
+  text-transform: uppercase;
+}
+
+input,
+select,
+textarea {
+  background: var(--field);
+  border: 1px solid var(--cyan);
+  color: var(--text);
+  font-family: inherit;
+  font-size: 13px;
+  outline: none;
+  padding: 8px;
+  width: 100%;
+}
+
+input:focus,
+select:focus,
+textarea:focus {
+  box-shadow: 0 0 0 1px var(--cyan), 0 0 12px rgba(5, 217, 232, .4);
+}
+
+select option {
+  background: var(--panel);
+}
+
+.row {
+  display: flex;
+  gap: 8px;
+}
+
+.row button {
+  flex: 1;
+}
+
+.check {
+  align-items: flex-start;
+  display: flex;
+  gap: 8px;
+  line-height: 1.35;
+}
+
+.check input {
+  accent-color: var(--cyan);
+  margin-top: 2px;
+  width: auto;
+}
+
+.hint {
+  color: var(--muted);
+  font-size: 11px;
+  line-height: 1.4;
+  margin: 0;
+}
+
+.hint.warn {
+  color: #ffb3c9;
+}
+
+main {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 10px;
+  overflow-y: auto;
+  padding: 12px;
+}
+
+.msg {
+  border: 1px solid rgba(5, 217, 232, .35);
+  padding: 9px 10px;
+  white-space: pre-wrap;
+  word-wrap: break-word;
+}
+
+.msg.user {
+  border-color: rgba(255, 42, 109, .6);
+  color: #ffd9e6;
+}
+
+.msg.assistant {
+  background: rgba(5, 217, 232, .04);
+}
+
+.msg.system {
+  border-color: rgba(255, 42, 109, .5);
+  color: #ffb3c9;
+  font-size: 12px;
+}
+
+.msg.action {
+  border: none;
+  border-left: 2px solid var(--magenta);
+  color: var(--muted);
+  font-size: 11px;
+  padding: 2px 8px;
+}
+
+.msg code {
+  background: rgba(5, 217, 232, .12);
+  color: var(--cyan);
+  padding: 1px 4px;
+}
+
+.msg pre {
+  background: #07021a;
+  border: 1px solid rgba(5, 217, 232, .35);
+  overflow-x: auto;
+  padding: 8px;
+}
+
+#status {
+  align-items: center;
+  color: var(--cyan);
+  display: flex;
+  font-size: 11px;
+  gap: 8px;
+  padding: 0 12px 6px;
+}
+
+#status[hidden] {
+  display: none;
+}
+
+#status::before {
+  animation: pulse 1s infinite steps(2);
+  content: '▮';
+  color: var(--magenta);
+}
+
+@keyframes pulse {
+  50% { opacity: .2; }
+}
+
+footer {
+  align-items: flex-end;
+  background: var(--panel);
+  border-top: 1px solid var(--cyan);
+  display: flex;
+  gap: 8px;
+  padding: 10px 12px;
+}
+
+footer textarea {
+  flex: 1;
+  resize: none;
+}
+
+footer button {
+  height: 42px;
+  width: 46px;
+}
diff --git a/chrome/browser/resources/goatai_chat/app.js b/chrome/browser/resources/goatai_chat/app.js
new file mode 100644
index 0000000000..94206226ae
--- /dev/null
+++ b/chrome/browser/resources/goatai_chat/app.js
@@ -0,0 +1,185 @@
+// Goatai IA — front-end do painel lateral.
+// Toda a lógica de rede/chaves fica no processo do navegador (C++).
+
+'use strict';
+
+const DEFAULT_MODELS = {
+  gpt: 'gpt-4.1-mini',
+  gemini: 'gemini-2.5-flash',
+  deepseek: 'deepseek-chat',
+  claude: 'claude-sonnet-4-5',
+};
+
+const state = {
+  provider: 'gpt',
+  model: DEFAULT_MODELS.gpt,
+  control: true,
+  hasKey: false,
+  busy: false,
+};
+
+const $ = (id) => document.getElementById(id);
+
+function escapeHtml(text) {
+  return String(text)
+      .replaceAll('&', '&amp;')
+      .replaceAll('<', '&lt;')
+      .replaceAll('>', '&gt;')
+      .replaceAll('"', '&quot;')
+      .replaceAll("'", '&#39;');
+}
+
+// Markdown mínimo e seguro: negrito, código inline e blocos de código.
+function renderMarkdown(text) {
+  const parts = String(text).split(/```/);
+  return parts.map((part, index) => {
+    if (index % 2 === 1) {
+      return `<pre><code>${escapeHtml(part.replace(/^\w*\n/, ''))}</code></pre>`;
+    }
+    return escapeHtml(part)
+        .replace(/`([^`]+)`/g, '<code>$1</code>')
+        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
+  }).join('');
+}
+
+function addMessage(role, text) {
+  const el = document.createElement('div');
+  el.className = `msg ${role}`;
+  if (role === 'assistant') {
+    el.innerHTML = renderMarkdown(text);
+  } else {
+    el.textContent = text;
+  }
+  $('messages').appendChild(el);
+  $('messages').scrollTop = $('messages').scrollHeight;
+  return el;
+}
+
+function setBusy(busy) {
+  state.busy = busy;
+  $('send').disabled = busy;
+  $('status').hidden = !busy;
+}
+
+function updateKeyState(masked, hasKey) {
+  state.hasKey = !!hasKey;
+  const el = $('keyState');
+  if (!hasKey) {
+    el.textContent = 'Nenhuma chave salva para este provedor.';
+  } else if (masked) {
+    el.textContent = `Chave salva: ${masked}`;
+  } else {
+    el.textContent = 'Chave salva (cifrada).';
+  }
+}
+
+function applyState(s) {
+  if (!s) return;
+  if (s.provider) {
+    state.provider = s.provider;
+    $('provider').value = s.provider;
+  }
+  if (s.model) {
+    state.model = s.model;
+    $('model').value = s.model;
+  }
+  if (typeof s.control === 'boolean') {
+    state.control = s.control;
+    $('control').checked = s.control;
+  }
+  updateKeyState(s.masked || '', s.hasKey);
+}
+
+function sendKey() {
+  const key = $('apiKey').value.trim();
+  if (!key) return;
+  chrome.send('goatai.saveKey', [state.provider, key]);
+  $('apiKey').value = '';
+}
+
+function sendMessage() {
+  const text = $('input').value.trim();
+  if (!text || state.busy) return;
+  addMessage('user', text);
+  $('input').value = '';
+  setBusy(true);
+  chrome.send('goatai.send', [text]);
+}
+
+function init() {
+  $('settingsToggle').addEventListener('click', () => {
+    $('settings').hidden = !$('settings').hidden;
+  });
+
+  $('provider').addEventListener('change', () => {
+    state.provider = $('provider').value;
+    state.model = DEFAULT_MODELS[state.provider] || '';
+    $('model').value = state.model;
+    chrome.send('goatai.setProvider', [state.provider]);
+  });
+
+  $('model').addEventListener('change', () => {
+    state.model = $('model').value.trim() || DEFAULT_MODELS[state.provider];
+    $('model').value = state.model;
+    chrome.send('goatai.setModel', [state.model]);
+  });
+
+  $('control').addEventListener('change', () => {
+    state.control = $('control').checked;
+    chrome.send('goatai.setControl', [state.control]);
+  });
+
+  $('saveKey').addEventListener('click', sendKey);
+  $('apiKey').addEventListener('keydown', (e) => {
+    if (e.key === 'Enter') {
+      e.preventDefault();
+      sendKey();
+    }
+  });
+  $('clearKey').addEventListener('click', () => {
+    chrome.send('goatai.clearKey', [state.provider]);
+  });
+
+  $('send').addEventListener('click', sendMessage);
+  $('input').addEventListener('keydown', (e) => {
+    if (e.key === 'Enter' && !e.shiftKey) {
+      e.preventDefault();
+      sendMessage();
+    }
+  });
+
+  chrome.send('goatai.getState', []);
+}
+
+window.goataiChatEvent = function(payload) {
+  let event;
+  try {
+    event = JSON.parse(payload);
+  } catch (e) {
+    return;
+  }
+  switch (event.type) {
+    case 'state':
+      applyState(event);
+      break;
+    case 'reply':
+      addMessage('assistant', event.text || '');
+      setBusy(false);
+      break;
+    case 'error':
+      addMessage('system', event.message || 'Erro desconhecido.');
+      setBusy(false);
+      break;
+    case 'status':
+      $('status').textContent = event.text || 'Pensando…';
+      break;
+    case 'action':
+      addMessage('action', event.text || '');
+      break;
+    case 'clear':
+      $('messages').textContent = '';
+      break;
+  }
+};
+
+document.addEventListener('DOMContentLoaded', init);
diff --git a/chrome/browser/resources/goatai_chat/index.html b/chrome/browser/resources/goatai_chat/index.html
new file mode 100644
index 0000000000..ffa192581e
--- /dev/null
+++ b/chrome/browser/resources/goatai_chat/index.html
@@ -0,0 +1,65 @@
+<!doctype html>
+<html dir="ltr" lang="pt-BR">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Goatai IA</title>
+  <link rel="stylesheet" href="app.css">
+</head>
+<body>
+  <div id="app">
+    <header>
+      <div class="brand">GOATAI<span>IA</span></div>
+      <button id="settingsToggle" class="icon" title="Configurar" aria-label="Configurar">⚙</button>
+    </header>
+
+    <section id="settings" hidden>
+      <label class="field">
+        <span>Provedor</span>
+        <select id="provider">
+          <option value="gpt">GPT (OpenAI)</option>
+          <option value="gemini">Gemini (Google)</option>
+          <option value="deepseek">DeepSeek</option>
+          <option value="claude">Claude (Anthropic)</option>
+        </select>
+      </label>
+
+      <label class="field">
+        <span>Modelo</span>
+        <input id="model" type="text" spellcheck="false" autocomplete="off">
+      </label>
+
+      <label class="field">
+        <span>Chave de API</span>
+        <input id="apiKey" type="password" spellcheck="false" autocomplete="off"
+               placeholder="cole a chave do provedor">
+      </label>
+
+      <div class="row">
+        <button id="saveKey" class="primary">Salvar chave</button>
+        <button id="clearKey">Remover</button>
+      </div>
+      <p id="keyState" class="hint"></p>
+
+      <label class="check">
+        <input type="checkbox" id="control">
+        <span>Permitir que a IA controle o navegador</span>
+      </label>
+      <p class="hint warn">
+        A chave é cifrada pelo cofre do sistema (libsecret/kwallet) e nunca é
+        enviada para a página. As requisições saem do processo do navegador.
+      </p>
+    </section>
+
+    <main id="messages" aria-live="polite"></main>
+
+    <div id="status" hidden></div>
+
+    <footer>
+      <textarea id="input" rows="2" placeholder="Pergunte ou peça uma ação…"></textarea>
+      <button id="send" class="primary" title="Enviar" aria-label="Enviar">➤</button>
+    </footer>
+  </div>
+  <script src="app.js"></script>
+</body>
+</html>
