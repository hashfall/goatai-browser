+
+void GoataiChatHandler::ExecuteAction(
+    const std::string& action,
+    const base::DictValue* args,
+    base::OnceCallback<void(std::string)> callback) {
+  BrowserWindowInterface* browser = GetBrowserWindow();
+  if (!browser || !browser->GetTabStripModel()) {
+    std::move(callback).Run("{\"ok\":false,\"error\":\"sem janela ativa\"}");
+    return;
+  }
+
+  if (action == "open_tab") {
+    const std::string url = StringArg(args, "url");
+    if (url.empty()) {
+      std::move(callback).Run("{\"ok\":false,\"error\":\"url vazia\"}");
+      return;
+    }
+    const GURL target(url);
+    if (!target.is_valid() || (target.scheme() != "http" &&
+                               target.scheme() != "https")) {
+      std::move(callback).Run(
+          "{\"ok\":false,\"error\":\"apenas http/https\"}");
+      return;
+    }
+    NavigateParams params(browser, target, ui::PAGE_TRANSITION_TYPED);
+    params.disposition = ui::mojom::WindowOpenDisposition::kNewForegroundTab;
+    Navigate(&params);
+    std::move(callback).Run(base::StrCat({"{\"ok\":true,\"url\":",
+                                          StringToJson(url), "}"}));
+    return;
+  }
+
+  if (action == "list_tabs") {
+    TabStripModel* model = browser->GetTabStripModel();
+    base::ListValue tabs;
+    for (int i = 0; i < model->count(); ++i) {
+      content::WebContents* contents = model->GetWebContentsAt(i);
+      if (!contents) {
+        continue;
+      }
+      base::DictValue tab;
+      tab.Set("index", i);
+      tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+      tab.Set("url", contents->GetLastCommittedURL().possibly_invalid_spec());
+      tab.Set("active", i == model->active_index());
+      tabs.Append(std::move(tab));
+    }
+    base::DictValue result;
+    result.Set("ok", true);
+    result.Set("tabs", std::move(tabs));
+    std::move(callback).Run(DictToJson(result));
+    return;
+  }
+
+  if (action == "switch_tab") {
+    const int index = IntArg(args, "index", -1);
+    if (index >= 0 && index < browser->GetTabStripModel()->count()) {
+      browser->GetTabStripModel()->ActivateTabAt(index);
+      std::move(callback).Run("{\"ok\":true}");
+    } else {
+      std::move(callback).Run("{\"ok\":false,\"error\":\"índice inválido\"}");
+    }
+    return;
+  }
+
+  if (action == "close_tab") {
+    const int index = IntArg(args, "index", -1);
+    if (index >= 0 && index < browser->GetTabStripModel()->count()) {
+      browser->GetTabStripModel()->CloseWebContentsAt(
+          index, CLOSE_USER_GESTURE | CLOSE_CREATE_HISTORICAL_TAB);
+      std::move(callback).Run("{\"ok\":true}");
+    } else {
+      std::move(callback).Run("{\"ok\":false,\"error\":\"índice inválido\"}");
+    }
+    return;
+  }
+
+  content::WebContents* contents = GetActiveWebContents();
+  if (!contents) {
+    std::move(callback).Run("{\"ok\":false,\"error\":\"sem aba ativa\"}");
+    return;
+  }
+
+  if (action == "navigate") {
+    const std::string url = StringArg(args, "url");
+    if (url.empty()) {
+      std::move(callback).Run("{\"ok\":false,\"error\":\"url vazia\"}");
+      return;
+    }
+    const GURL target(url);
+    if (!target.is_valid() || (target.scheme() != "http" &&
+                               target.scheme() != "https")) {
+      std::move(callback).Run(
+          "{\"ok\":false,\"error\":\"apenas http/https\"}");
+      return;
+    }
+    contents->GetController().LoadURL(target, content::Referrer(),
+                                      ui::PAGE_TRANSITION_TYPED,
+                                      std::string());
+    std::move(callback).Run(base::StrCat({"{\"ok\":true,\"url\":",
+                                          StringToJson(url), "}"}));
+    return;
+  }
+
+  if (action == "back") {
+    if (contents->GetController().CanGoBack()) {
+      contents->GetController().GoBack();
+      std::move(callback).Run("{\"ok\":true}");
+    } else {
+      std::move(callback).Run("{\"ok\":false,\"error\":\"sem histórico\"}");
+    }
+    return;
+  }
+
+  if (action == "forward") {
+    if (contents->GetController().CanGoForward()) {
+      contents->GetController().GoForward();
+      std::move(callback).Run("{\"ok\":true}");
+    } else {
+      std::move(callback).Run("{\"ok\":false,\"error\":\"sem histórico\"}");
+    }
+    return;
+  }
+
+  if (action == "reload") {
+    contents->GetController().Reload(content::ReloadType::NORMAL, false);
+    std::move(callback).Run("{\"ok\":true}");
+    return;
+  }
+
+  if (action == "read_page") {
+    const std::u16string script = uR"((function(){
+      try {
+        return JSON.stringify({
+          ok: true,
+          title: document.title,
+          url: location.href,
+          text: (document.body ? document.body.innerText : '').slice(0, 12000)
+        });
+      } catch (e) {
+        return JSON.stringify({ok: false, error: String(e)});
+      }
+    })())";
+    RunJavaScript(script, std::move(callback));
+    return;
+  }
+
+  if (action == "click") {
+    const std::string selector = StringArg(args, "selector");
+    const std::string text = StringArg(args, "text");
+    if (selector.empty() && text.empty()) {
+      std::move(callback).Run(
+          "{\"ok\":false,\"error\":\"informe selector ou text\"}");
+      return;
+    }
+    const std::u16string script =
+        base::UTF8ToUTF16(base::StrCat({R"((function(){
+          const sel = )",
+                                        StringToJson(selector), R"(;
+          const needle = )",
+                                        StringToJson(text), R"(;
+          let el = null;
+          if (sel) { try { el = document.querySelector(sel); } catch (e) {} }
+          if (!el && needle) {
+            const n = needle.toLowerCase();
+            const cands = Array.from(document.querySelectorAll(
+                'a,button,[role="button"],input[type="submit"],input[type="button"]'));
+            el = cands.find(e => ((e.innerText || e.value ||
+                e.getAttribute('aria-label') || '').toLowerCase().trim().includes(n)));
+          }
+          if (!el) return JSON.stringify({ok:false, error:'elemento não encontrado'});
+          el.scrollIntoView({block:'center'});
+          el.click();
+          return JSON.stringify({ok:true, info:(el.innerText || el.tagName || '').slice(0,80)});
+        })())"}));
+    RunJavaScript(script, std::move(callback));
+    return;
+  }
+
+  if (action == "type") {
+    const std::string selector = StringArg(args, "selector");
+    const std::string text = StringArg(args, "text");
+    const bool submit = BoolArg(args, "submit");
+    if (selector.empty()) {
+      std::move(callback).Run(
+          "{\"ok\":false,\"error\":\"informe selector\"}");
+      return;
+    }
+    const std::u16string script = base::UTF8ToUTF16(base::StrCat(
+        {"(function(){const el = document.querySelector(",
+         StringToJson(selector),
+         ");if(!el)return JSON.stringify({ok:false,error:'campo não "
+         "encontrado'});el.focus();const value = ",
+         StringToJson(text),
+         ";if(el.isContentEditable){el.textContent=value;}else{const proto = "
+         "el instanceof HTMLTextAreaElement ? HTMLTextAreaElement.prototype : "
+         "HTMLInputElement.prototype;const setter = "
+         "Object.getOwnPropertyDescriptor(proto,'value').set;"
+         "setter.call(el,value);}el.dispatchEvent(new "
+         "Event('input',{bubbles:true}));el.dispatchEvent(new "
+         "Event('change',{bubbles:true}));const shouldSubmit = ",
+         submit ? "true" : "false",
+         ";if(shouldSubmit && el.form){el.form.requestSubmit();}return "
+         "JSON.stringify({ok:true});})()"}));
+    RunJavaScript(script, std::move(callback));
+    return;
+  }
+
+  if (action == "scroll") {
+    const std::string direction = StringArg(args, "direction");
+    const char* delta = direction == "up" ? "-" : "";
+    const std::u16string script =
+        base::UTF8ToUTF16(base::StrCat({"(function(){window.scrollBy(0,",
+                                        delta,
+                                        "window.innerHeight*0.8);return "
+                                        "JSON.stringify({ok:true});})()"}));
+    RunJavaScript(script, std::move(callback));
+    return;
+  }
+
+  std::move(callback).Run("{\"ok\":false,\"error\":\"ação desconhecida\"}");
+}
+
+void GoataiChatHandler::RunJavaScript(
+    const std::u16string& script,
+    base::OnceCallback<void(std::string)> callback) {
+  content::WebContents* contents = GetActiveWebContents();
+  if (!contents || !contents->GetPrimaryMainFrame()) {
+    std::move(callback).Run("{\"ok\":false,\"error\":\"sem aba ativa\"}");
+    return;
+  }
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      script,
+      base::BindOnce(
+          [](base::OnceCallback<void(std::string)> callback,
+             base::Value result) {
+            std::string out;
+            if (result.is_string()) {
+              out = result.GetString();
+            } else if (!result.is_none()) {
+              base::JSONWriter::Write(result, &out);
+            }
+            std::move(callback).Run(out.empty() ? "{\"ok\":true}" : out);
+          },
+          std::move(callback)),
+      content::ISOLATED_WORLD_ID_CONTENT_END + 1);
+}
