diff --git a/chrome/browser/ui/views/frame/toolbar_auto_hide.cc b/chrome/browser/ui/views/frame/toolbar_auto_hide.cc
new file mode 100644
index 0000000000..fb8052cdc4
--- /dev/null
+++ b/chrome/browser/ui/views/frame/toolbar_auto_hide.cc
@@ -0,0 +1,203 @@
+// Copyright 2026 Goatai. All rights reserved.
+// Use of this source code is governed by a BSD-style license.
+
+#include "chrome/browser/ui/views/frame/toolbar_auto_hide.h"
+
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/top_container_view.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/events/event_observer.h"
+#include "ui/events/types/event_type.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/event_monitor.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// Faixa no topo da janela que revela a toolbar quando o mouse encosta.
+constexpr int kRevealHeight = 4;
+constexpr base::TimeDelta kHideDelay = base::Milliseconds(250);
+
+}  // namespace
+
+ToolbarAutoHideController::ToolbarAutoHideController(
+    BrowserView* browser_view,
+    ToolbarView* toolbar)
+    : browser_view_(browser_view), toolbar_(toolbar) {
+  views::Widget* widget = browser_view_->GetWidget();
+  if (!widget) {
+    return;
+  }
+  if (widget->GetNativeWindow()) {
+    event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, widget->GetNativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMouseDragged,
+         ui::EventType::kMouseEntered, ui::EventType::kMouseExited,
+         ui::EventType::kKeyPressed});
+  }
+  focus_manager_ = widget->GetFocusManager();
+  if (focus_manager_) {
+    focus_manager_->AddFocusChangeListener(this);
+  }
+}
+
+ToolbarAutoHideController::~ToolbarAutoHideController() {
+  hide_timer_.Stop();
+  if (focus_manager_) {
+    focus_manager_->RemoveFocusChangeListener(this);
+  }
+}
+
+bool ToolbarAutoHideController::ShouldSuspend() const {
+  if (!browser_view_ || !toolbar_) {
+    return true;
+  }
+  views::Widget* widget = browser_view_->GetWidget();
+  // Em fullscreen o ImmersiveModeController cuida da barra.
+  return !widget || widget->IsFullscreen();
+}
+
+bool ToolbarAutoHideController::MouseOverToolbar() const {
+  if (!event_monitor_ || !toolbar_) {
+    return false;
+  }
+  const gfx::Point mouse = event_monitor_->GetLastMouseLocation();
+  if (toolbar_->GetVisible() && toolbar_->GetBoundsInScreen().Contains(mouse)) {
+    return true;
+  }
+  gfx::Rect reveal = browser_view_->GetBoundsInScreen();
+  reveal.set_height(kRevealHeight);
+  return reveal.Contains(mouse);
+}
+
+bool ToolbarAutoHideController::FocusInToolbar() const {
+  if (!focus_manager_ || !toolbar_) {
+    return false;
+  }
+  views::View* focused = focus_manager_->GetFocusedView();
+  for (views::View* view = focused; view; view = view->parent()) {
+    if (view == toolbar_) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ToolbarAutoHideController::ContentsHasFocus() const {
+  if (!focus_manager_ || !browser_view_) {
+    return false;
+  }
+  views::View* focused = focus_manager_->GetFocusedView();
+  views::WebView* contents = browser_view_->GetActiveContentsWebView();
+  if (!focused || !contents) {
+    return false;
+  }
+  for (views::View* view = focused; view; view = view->parent()) {
+    if (view == contents) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void ToolbarAutoHideController::ShowToolbar() {
+  views::View* top = browser_view_->top_container();
+  if (ShouldSuspend() || !top || top->GetVisible()) {
+    return;
+  }
+  toolbar_->SetVisible(true);
+  top->SetVisible(true);
+  top->InvalidateLayout();
+}
+
+void ToolbarAutoHideController::ScheduleHide() {
+  views::View* top = browser_view_->top_container();
+  if (ShouldSuspend() || !top || !top->GetVisible() ||
+      hide_timer_.IsRunning()) {
+    return;
+  }
+  hide_timer_.Start(FROM_HERE, kHideDelay, this,
+                    &ToolbarAutoHideController::HideToolbarIfAllowed);
+}
+
+void ToolbarAutoHideController::HideToolbarIfAllowed() {
+  views::View* top = browser_view_->top_container();
+  if (ShouldSuspend() || !top || !top->GetVisible()) {
+    return;
+  }
+  // Só esconde quando o conteúdo (a página) está em foco e o mouse saiu da
+  // barra. Com menu ou bolha aberta o foco está neles, então a barra fica.
+  if (!ContentsHasFocus() || MouseOverToolbar() || FocusInToolbar()) {
+    return;
+  }
+  toolbar_->SetVisible(false);
+  top->SetVisible(false);
+  top->InvalidateLayout();
+}
+
+void ToolbarAutoHideController::OnEvent(const ui::Event& event) {
+  if (ShouldSuspend()) {
+    return;
+  }
+  if (event.type() == ui::EventType::kKeyPressed) {
+    // Atalhos que focam a barra (omnibox) precisam mostrá-la antes.
+    const ui::KeyEvent* key = event.AsKeyEvent();
+    if (key) {
+      const bool ctrl = key->IsControlDown();
+      const bool alt = key->IsAltDown();
+      const bool shortcut =
+          (ctrl && (key->key_code() == ui::VKEY_L ||
+                    key->key_code() == ui::VKEY_K ||
+                    key->key_code() == ui::VKEY_E ||
+                    key->key_code() == ui::VKEY_T)) ||
+          (alt && key->key_code() == ui::VKEY_D) ||
+          key->key_code() == ui::VKEY_F6;
+      if (shortcut) {
+        hide_timer_.Stop();
+        ShowToolbar();
+      }
+    }
+    return;
+  }
+
+  switch (event.type()) {
+    case ui::EventType::kMouseMoved:
+    case ui::EventType::kMouseDragged:
+    case ui::EventType::kMouseEntered:
+    case ui::EventType::kMouseExited:
+      break;
+    default:
+      return;
+  }
+
+  if (MouseOverToolbar()) {
+    hide_timer_.Stop();
+    ShowToolbar();
+    return;
+  }
+  ScheduleHide();
+}
+
+void ToolbarAutoHideController::OnWillChangeFocus(views::View* focused_before,
+                                                  views::View* focused_now) {}
+
+void ToolbarAutoHideController::OnDidChangeFocus(views::View* focused_before,
+                                                 views::View* focused_now) {
+  if (ShouldSuspend()) {
+    return;
+  }
+  if (FocusInToolbar()) {
+    hide_timer_.Stop();
+    ShowToolbar();
+    return;
+  }
+  // Menu/bolha aberta: o conteúdo não está em foco, mantém a barra.
+  ScheduleHide();
+}
