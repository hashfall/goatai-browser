+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_recipe.h"
+#include "ui/color/dynamic_color/palette.h"
+#include "ui/color/dynamic_color/palette_factory.h"
+#include "ui/gfx/color_palette.h"
+
+namespace {
+
+// Paletas tonais da marca. Geradas uma única vez e cacheadas.
+const ui::Palette& GoataiVioletPalette() {
+  static base::NoDestructor<std::unique_ptr<ui::Palette>> palette(
+      ui::GeneratePalette(SkColorSetRGB(0x05, 0xD9, 0xE8),
+                          ui::ColorProviderKey::SchemeVariant::kTonalSpot));
+  return **palette;
+}
+
+const ui::Palette& GoataiPinkPalette() {
+  static base::NoDestructor<std::unique_ptr<ui::Palette>> palette(
+      ui::GeneratePalette(SkColorSetRGB(0xFF, 0x2A, 0x6D),
+                          ui::ColorProviderKey::SchemeVariant::kTonalSpot));
+  return **palette;
+}
+
+}  // namespace
+
+void AddGoataiColorMixer(ui::ColorProvider* provider,
+                         const ui::ColorProviderKey& key) {
+  const bool dark =
+      key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  ui::ColorMixer& mixer = provider->AddMixer();
+
+  // Goatai vaporwave: navy profundo, ciano neon e magenta.
+  const SkColor frame = SkColorSetRGB(0x0A, 0x04, 0x20);
+  const SkColor frame_inactive = SkColorSetRGB(0x07, 0x02, 0x18);
+  const SkColor toolbar = SkColorSetRGB(0x14, 0x08, 0x33);
+  const SkColor tab_active = SkColorSetRGB(0x1B, 0x0B, 0x3B);
+  const SkColor ntp_background = SkColorSetRGB(0x0A, 0x04, 0x20);
+  const SkColor ntp_text = SkColorSetRGB(0xE8, 0xF9, 0xFF);
+  const SkColor cyan = SkColorSetRGB(0x05, 0xD9, 0xE8);
+  const SkColor magenta = SkColorSetRGB(0xFF, 0x2A, 0x6D);
+  const SkColor field = SkColorSetRGB(0x12, 0x06, 0x2B);
+
+  // Moldura, barra de abas e toolbar.
+  mixer[ui::kColorFrameActive] = {frame};
+  mixer[ui::kColorFrameInactive] = {frame_inactive};
+  mixer[kColorToolbar] = {toolbar};
+  mixer[kColorToolbarBackgroundSubtleEmphasis] = {toolbar};
+  mixer[kColorToolbarText] = {cyan};
+  mixer[kColorToolbarButtonIcon] = {cyan};
+  mixer[kColorToolbarButtonIconDefault] = {cyan};
+  mixer[kColorToolbarButtonIconHovered] = {SK_ColorWHITE};
+  mixer[kColorToolbarButtonIconInactive] = {SkColorSetA(cyan, 0xB3)};
+  mixer[kColorToolbarTopSeparatorFrameActive] = {cyan};
+  mixer[kColorToolbarTopSeparatorFrameInactive] = {magenta};
+  mixer[kColorToolbarContentAreaSeparator] = {cyan};
+
+  // Abas.
+  mixer[kColorTabBackgroundActiveFrameActive] = {tab_active};
+  mixer[kColorTabBackgroundActiveFrameInactive] = {tab_active};
+  mixer[kColorTabBackgroundInactiveFrameActive] = {frame};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {frame_inactive};
+  mixer[kColorTabForegroundActiveFrameActive] = {cyan};
+  mixer[kColorTabForegroundActiveFrameInactive] = {cyan};
+  mixer[kColorTabForegroundInactiveFrameActive] = {ntp_text};
+  mixer[kColorTabForegroundInactiveFrameInactive] = {SkColorSetA(ntp_text, 0x99)};
+  mixer[kColorTabStrokeFrameActive] = {cyan};
+  mixer[kColorTabStrokeFrameInactive] = {magenta};
+  mixer[kColorTabDividerFrameActive] = {cyan};
+  mixer[kColorTabDividerFrameInactive] = {magenta};
+
+  // Barra de favoritos acompanha a toolbar.
+  mixer[kColorBookmarkBarBackground] = {toolbar};
+  mixer[kColorBookmarkBarForeground] = {cyan};
+  mixer[kColorBookmarkButtonIcon] = {cyan};
+
+  // New Tab Page.
+  mixer[kColorNewTabPageBackground] = {ntp_background};
+  mixer[kColorNewTabPageText] = {ntp_text};
+  mixer[kColorNewTabPageLink] = {cyan};
+  mixer[kColorNewTabPageHeader] = {magenta};
+  mixer[kColorNewTabPageCommonInputPlaceholder] =
+      {SkColorSetRGB(0x7D, 0xD3, 0xFC)};
+
+  // Searchbox da NTP.
+  mixer[kColorSearchboxBackground] = {field};
+  mixer[kColorSearchboxBackgroundHovered] = {tab_active};
+  mixer[kColorSearchboxForeground] = {ntp_text};
+  mixer[kColorSearchboxPlaceholder] = {SkColorSetRGB(0x7D, 0xD3, 0xFC)};
+  mixer[kColorSearchboxBorder] = {cyan};
+  mixer[kColorSearchboxResultsBackground] = {field};
+  mixer[kColorSearchboxResultsForeground] = {ntp_text};
+  mixer[kColorSearchboxResultsBackgroundHovered] = {tab_active};
+  mixer[kColorSearchboxResultsFocusIndicator] = {cyan};
+
+  // New Tab Page: telhas, chips e composebox em navy neon, sem herdar o
+  // tema de cor do perfil (que deixa as superfícies avermelhadas).
+  mixer[kColorNewTabPageMostVisitedTileBackground] = {field};
+  mixer[kColorNewTabPageMostVisitedForeground] = {ntp_text};
+  mixer[kColorNewTabPageActionChipBackground] = {field};
+  mixer[kColorNewTabPageActionChipBackgroundHover] = {tab_active};
+  mixer[kColorNewTabPageActionChipTextTitle] = {ntp_text};
+  mixer[kColorNewTabPageActionChipTextBody] = {SkColorSetRGB(0x7D, 0xD3, 0xFC)};
+  mixer[kColorNewTabPageActionChipDeepSearchIcon] = {cyan};
+  mixer[kColorNewTabPageComposeboxSubmitButtonBackground] = {magenta};
+
+  // Composebox da NTP (a caixa grande de pesquisa).
+  mixer[kColorComposeboxBackground] = {field};
+  mixer[kColorComposeboxFont] = {ntp_text};
+  mixer[kColorComposeboxFontLight] = {SkColorSetRGB(0x7D, 0xD3, 0xFC)};
+  mixer[kColorComposeboxInputIcon] = {cyan};
+  mixer[kColorComposeboxHover] = {tab_active};
+  mixer[kColorComposeboxGhostCardBackground] = {tab_active};
+  mixer[kColorComposeboxFileChipBackground] = {field};
+  mixer[kColorComposeboxFileChipFaviconBackground] = {tab_active};
+  mixer[kColorComposeboxFileChipText] = {ntp_text};
+  mixer[kColorComposeboxLink] = {cyan};
+  mixer[kColorComposeboxTypeAhead] = {SkColorSetRGB(0x7D, 0xD3, 0xFC)};
+  mixer[kColorComposeboxTypeAheadChip] = {cyan};
+
+  // Omnibox da barra de endereço.
+  mixer[ui::kColorSysOmniboxContainer] = {field};
+  mixer[kColorLocationBarBackground] = {field};
+  mixer[kColorLocationBarBackgroundHovered] = {tab_active};
+  mixer[kColorLocationBarBorder] = {cyan};
+  mixer[kColorOmniboxText] = {ntp_text};
+
+  // Destaques: foco ciano, botões primários magenta.
+  mixer[ui::kColorAccent] = {cyan};
+  mixer[ui::kColorSysPrimary] = {magenta};
+  mixer[ui::kColorSysOnPrimary] = {SK_ColorWHITE};
+  mixer[ui::kColorSysPrimaryContainer] = {tab_active};
+  mixer[ui::kColorSysOnPrimaryContainer] = {ntp_text};
+  mixer[ui::kColorSysSecondary] = {cyan};
+  mixer[ui::kColorSysOnSecondary] = {SK_ColorBLACK};
+  mixer[ui::kColorSysSecondaryContainer] = {SkColorSetRGB(0x2A, 0x0A, 0x3F)};
+  mixer[ui::kColorSysOnSecondaryContainer] = {ntp_text};
+
+  // Substitui a paleta Material padrão (azul) pela paleta Goatai. Isso
+  // recolore todas as superfícies Material que derivam dos ref colors.
+  const ui::TonalPalette& purple = GoataiVioletPalette().primary();
+  mixer[ui::kColorRefPrimary0] = {purple.get(0)};
+  mixer[ui::kColorRefPrimary10] = {purple.get(10)};
+  mixer[ui::kColorRefPrimary20] = {purple.get(20)};
+  mixer[ui::kColorRefPrimary25] = {purple.get(25)};
+  mixer[ui::kColorRefPrimary30] = {purple.get(30)};
+  mixer[ui::kColorRefPrimary40] = {purple.get(40)};
+  mixer[ui::kColorRefPrimary50] = {purple.get(50)};
+  mixer[ui::kColorRefPrimary60] = {purple.get(60)};
+  mixer[ui::kColorRefPrimary70] = {purple.get(70)};
+  mixer[ui::kColorRefPrimary80] = {purple.get(80)};
+  mixer[ui::kColorRefPrimary90] = {purple.get(90)};
+  mixer[ui::kColorRefPrimary95] = {purple.get(95)};
+  mixer[ui::kColorRefPrimary99] = {purple.get(99)};
+  mixer[ui::kColorRefPrimary100] = {purple.get(100)};
+
+  const ui::TonalPalette& pink = GoataiPinkPalette().primary();
+  mixer[ui::kColorRefSecondary0] = {pink.get(0)};
+  mixer[ui::kColorRefSecondary10] = {pink.get(10)};
+  mixer[ui::kColorRefSecondary12] = {pink.get(12)};
+  mixer[ui::kColorRefSecondary15] = {pink.get(15)};
+  mixer[ui::kColorRefSecondary20] = {pink.get(20)};
+  mixer[ui::kColorRefSecondary25] = {pink.get(25)};
+  mixer[ui::kColorRefSecondary30] = {pink.get(30)};
+  mixer[ui::kColorRefSecondary35] = {pink.get(35)};
+  mixer[ui::kColorRefSecondary40] = {pink.get(40)};
+  mixer[ui::kColorRefSecondary50] = {pink.get(50)};
+  mixer[ui::kColorRefSecondary60] = {pink.get(60)};
+  mixer[ui::kColorRefSecondary70] = {pink.get(70)};
+  mixer[ui::kColorRefSecondary80] = {pink.get(80)};
+  mixer[ui::kColorRefSecondary90] = {pink.get(90)};
+  mixer[ui::kColorRefSecondary95] = {pink.get(95)};
+  mixer[ui::kColorRefSecondary99] = {pink.get(99)};
+  mixer[ui::kColorRefSecondary100] = {pink.get(100)};
+}
