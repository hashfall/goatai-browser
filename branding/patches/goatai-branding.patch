+
+void GoataiChatHandler::EnsureEncryptor(
+    base::OnceCallback<void(bool)> callback) {
+  if (encryptor_) {
+    std::move(callback).Run(true);
+    return;
+  }
+  os_crypt_async::OSCryptAsync* os_crypt =
+      g_browser_process ? g_browser_process->os_crypt_async() : nullptr;
+  if (!os_crypt) {
+    std::move(callback).Run(false);
+    return;
+  }
+  os_crypt->GetInstance(base::BindOnce(
+      [](base::WeakPtr<GoataiChatHandler> self,
+         base::OnceCallback<void(bool)> callback,
+         scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+        if (!self) {
+          std::move(callback).Run(false);
+          return;
+        }
+        self->encryptor_ = std::move(encryptor);
+        std::move(callback).Run(self->encryptor_ != nullptr);
+      },
+      weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+std::string GoataiChatHandler::DecryptStoredKey(
+    const std::string& provider) const {
+  if (!encryptor_) {
+    return std::string();
+  }
+  const std::string stored = StoredKeyPref(provider);
+  if (stored.empty()) {
+    return std::string();
+  }
+  std::string cipher;
+  if (!base::Base64Decode(stored, &cipher)) {
+    return std::string();
+  }
+  std::string plain;
+  if (!encryptor_->DecryptString(cipher, &plain)) {
+    return std::string();
+  }
+  return plain;
+}
+
+std::string GoataiChatHandler::MaskKey(const std::string& key) const {
+  if (key.size() <= 4) {
+    return "****";
+  }
+  return base::StrCat({"••••", key.substr(key.size() - 4)});
+}
