+namespace {
+
+GURL GoataiChatURL(Profile* profile) {
+  // Se a extensão Goatai IA estiver instalada, usa a página dela (APIs de
+  // extensão: storage.session, scripting, tabs). Senão, cai no WebUI nativo.
+  if (auto* registry = extensions::ExtensionRegistry::Get(profile)) {
+    for (const auto& extension : registry->enabled_extensions()) {
+      if (extension->name() == "Goatai IA") {
+        GURL url = extension->url().Resolve("panel.html");
+        if (url.is_valid()) {
+          return url;
+        }
+      }
+    }
+  }
+  return GURL(chrome::kChromeUIGoataiChatURL);
+}
+
+std::unique_ptr<views::View> CreateGoataiChatView(Profile* profile,
+                                                 SidePanelEntryScope& scope) {
+  auto web_view = std::make_unique<views::WebView>(profile);
+  web_view->LoadInitialURL(GoataiChatURL(profile));
+  if (web_view->web_contents()) {
+    // Permite ao backend descobrir a janela que hospeda o painel.
+    webui::SetBrowserWindowInterface(web_view->web_contents(),
+                                     &scope.GetBrowserWindowInterface());
+  }
+  return web_view;
+}
+
+}  // namespace
+
+void RegisterGoataiChatSidePanel(BrowserWindowInterface* browser,
+                                 Profile* profile) {
+  if (!browser || !profile) {
+    return;
+  }
+  SidePanelRegistry* registry = SidePanelRegistry::From(browser);
+  if (!registry) {
+    return;
+  }
+  const SidePanelEntryKey key(SidePanelEntry::Id::kGoataiChat);
+  if (registry->GetEntryForKey(key)) {
+    return;
+  }
+  registry->Register(std::make_unique<SidePanelEntry>(
+      key, base::BindRepeating(&CreateGoataiChatView, profile),
+      base::NullCallback()));
+}
+
+void ToggleGoataiChatSidePanel(BrowserWindowInterface* browser,
+                               Profile* profile) {
+  if (!browser || !profile) {
+    return;
+  }
+  RegisterGoataiChatSidePanel(browser, profile);
+  if (SidePanelUI* side_panel = SidePanelUI::From(browser)) {
+    side_panel->Toggle(SidePanelEntryKey(SidePanelEntry::Id::kGoataiChat),
+                       SidePanelOpenTrigger::kToolbarButton);
+  }
+}
